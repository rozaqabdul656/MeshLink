# Docker image version. Use a pinned release in production, e.g. 1.0.2.
MESHLINK_IMAGE_TAG=latest
MESHLINK_PORT=20128
MESHLINK_NODE_NAME=meshlink-node
MESHLINK_NODE_ID=meshlink-node

# The endpoint other MeshLink nodes use to reach this node. Use a VPN IP or
# HTTPS URL; do not expose a plain HTTP node to the public internet.
MESHLINK_ENDPOINT=https://meshlink.example.internal
MESHLINK_DASHBOARD_PASSWORD=replace-with-a-long-unique-password

# JSON array of trusted Ed25519 public keys and their least-privilege scopes.
# Keep this as a single line, and never commit the real values.
MESHLINK_TRUSTED_AGENTS=[]
MESHLINK_RATE_LIMIT_MAX=120
